# Test-only dependency at the REPO ROOT: `npm install jsdom` before running
# tests/smoke.mjs. The frontend itself has no build step and no manifest.
#
# These patterns are anchored with a leading slash on purpose. Unanchored, git
# applies them at every depth, which silently excluded server/package.json —
# the backend's real dependency manifest — and left a fresh clone unable to
# run `npm install` at all.
node_modules/
/package-lock.json
/package.json

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Transient
*.log
npm-debug.log*

# Backend
server/node_modules/
server/.env
server/data/
