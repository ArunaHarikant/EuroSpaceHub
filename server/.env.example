# ==========================================================================
# Copy to server/.env and fill in. server/.env is gitignored — keep it that way.
# ==========================================================================

# ---- Backblaze B2 (S3-compatible API) ----
# From B2 → Application Keys. The key must be scoped to this bucket and have
# at least: listBuckets, listFiles, readFiles, writeFiles, deleteFiles.
B2_KEY_ID=
B2_APPLICATION_KEY=

# B2 bucket names are LOWERCASE-ONLY. If the console shows "EuroSpaceHub",
# the actual name is almost certainly "eurospacehub" — use exactly what the
# console shows under Buckets. A wrong name surfaces as NoSuchBucket at boot.
B2_BUCKET_NAME=eurospacehub
B2_BUCKET_ID=25cb8bbb0ff5001aac0a0d1e

B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003

# Leave false to use virtual-hosted addressing (bucket.s3.<region>...).
# Set true if the bucket name is not DNS-safe or you hit addressing errors.
B2_FORCE_PATH_STYLE=false

# Presigned URL lifetimes, in seconds.
# Upload: long enough for a 25 MB file on a poor connection.
# Download: a signed GET is a bearer token — keep it barely longer than a click.
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=300

# ---- Server ----
PORT=3000
NODE_ENV=development

# Session cookie lifetime, hours.
SESSION_TTL_HOURS=12

# auto = Secure only when NODE_ENV=production. Force with true/false.
# MUST be true in production — the cookie is the session.
COOKIE_SECURE=auto

# Set to 1 when running behind a reverse proxy so req.ip is the real client.
TRUST_PROXY=0

# ---- Data ----
# DATA_DIR=./data
# DB_PATH=./data/hub.db

# ---- Seeding ----
# Password for the supervisor account created by `npm run seed`.
# Change it immediately after first sign-in.
SEED_SUPERVISOR_EMAIL=foing@eurospacehub.local
SEED_SUPERVISOR_PASSWORD=
